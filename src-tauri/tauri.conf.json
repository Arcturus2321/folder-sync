{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FolderSync",
  "version": "0.1.0",
  "identifier": "com.foldersync.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FolderSync",
        "width": 720,
        "height": 560,
        "resizable": true,
        "minWidth": 600,
        "minHeight": 480,
        "decorations": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
"plugins": {
    "shell": {
      "open": true
    }
  }
}
